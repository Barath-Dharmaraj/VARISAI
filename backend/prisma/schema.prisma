datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Office {
  id          String    @id @default(uuid())
  name        String
  category    String    // Government Bank, Taluk Office, VAO Office, Municipal Office
  address     String
  district    String
  state       String
  openingTime String    @default("09:00 AM")
  closingTime String    @default("05:00 PM")
  isActive    Boolean   @default(true)
  services    Service[]
  counters    Counter[]
  bookings    Booking[]
  users       User[]
  createdAt   DateTime  @default(now())
}

model Service {
  id                String    @id @default(uuid())
  officeId          String
  office            Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name              String
  description       String
  avgServiceMinutes Float     @default(15.0)
  prefix            String    @default("A")
  isActive          Boolean   @default(true)
  bookings          Booking[]
  createdAt         DateTime  @default(now())
}

model Counter {
  id            String   @id @default(uuid())
  officeId      String
  office        Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  counterNumber Int
  staffName     String
  isOpen        Boolean  @default(true)
  currentToken  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  password         String?
  phone            String?
  role             String    @default("CITIZEN") // CITIZEN or STAFF
  staffId          String?
  department       String?
  officeId         String?
  office           Office?   @relation(fields: [officeId], references: [id])
  priorityCategory String?   @default("none")
  district         String?
  createdAt        DateTime  @default(now())
}

model Booking {
  id                   String    @id @default(uuid())
  bookingRef           String    @unique
  tokenNumber          String
  email                String
  citizenName          String?
  officeId             String
  office               Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  serviceId            String
  service              Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  priorityCategory     String    // none, senior_citizen, pregnant_woman, differently_abled
  status               String    @default("WAITING") // WAITING, SERVING, COMPLETED, SKIPPED, CANCELLED
  fifoPosition         Int       @default(1)
  priorityScore        Float     @default(0.0)
  predictedWaitMinutes Float     @default(15.0)
  counterNumber        Int?
  calledAt             DateTime?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model OtpVerification {
  id         String   @id @default(uuid())
  email      String
  otp        String
  userType   String   @default("CITIZEN") // CITIZEN or STAFF
  expiresAt  DateTime
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
}
